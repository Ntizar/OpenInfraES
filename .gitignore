# Sistema
.DS_Store
Thumbs.db
desktop.ini

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Temporales
*.log
*.tmp
datos/_*.png
datos/_*.svg
*.json.tmp
ine_ops.json

# Capas oficiales pesadas: se descargan con scripts/capas_oficiales.py, no se versionan
datos/oficial/parques-eolicos.geojson
datos/oficial/plantas-solares.geojson
datos/oficial/generacion-electrica-provincia.geojson
datos/oficial/almacenamiento-petrolifero.geojson
datos/oficial/residuos-radiactivos.geojson
datos/oficial/hidrogeno-red.geojson
_mapa*.png
datos/rios.geojson

# Credenciales (nunca versionar)
.env
.env.*
!.env.example

# Restos de pruebas en la raiz
*.csv
sism.json
r.json
w.txt
a.xml

# Restos de pruebas en la raiz: solo el visor es HTML versionado
/*.html
!/mapa.html

# Nunca en la raiz: respuestas de prueba
/*.json
/*.xml
!/package.json

# El catalogo NAP son 10 MB y se regenera con scripts/nap.py --catalogo
datos/nap_catalogo.json

# XML crudos de DATEX II: 88 MB, se regeneran con scripts/dgt.py
datos/dgt/*.xml
datos/.cp_api_cache*.json

# caché de tablas del INE (58 MB): se regenera sola, no va al repo
datos/ine/.cache/

# Almacén entidades+atributos: se regenera con scripts/store.py, no se versiona
datos/store.duckdb
datos/store/*.geojson
datos/store/*.parquet
datos/municipios_mart.csv
datos/store/*_recibo.json

# informe del auditor de duplicados: se regenera con scripts/duplicados.py
datos/duplicados.json
